# ── 집 PC 24/7 배포용 환경변수 예시 ──
# 이 파일을 복사해 `.env`로 쓰고 값을 채운다 (.env는 .gitignore로 커밋 제외).
#   cp .env.prod.example .env
# (외부 노출은 Tailscale Funnel이 담당 — 여기엔 터널 관련 값이 없다. DEPLOY.md 참고.)

# ── DB 비밀번호 (원하는 강한 값으로) ──
DB_PASSWORD=change-me-strong-db-password

# ── JWT 서명 키 (필수, 32바이트 이상 고정값) ──
# 절대 바꾸지 말 것 — 바뀌면 발급된 모든 로그인 토큰이 무효화된다.
# 새로 생성:  openssl rand -base64 48
JWT_SECRET=

# ── 카카오 앱 ID (필수, 0보다 커야 부팅됨) ──
# Kakao Developers → 내 애플리케이션 → 앱 설정 → 요약 정보 → "앱 ID"(숫자).
# (클라의 kakao.native.app.key와는 다른 값 — 서버가 카카오 토큰 검증에 쓰는 숫자 ID)
KAKAO_APP_ID=

# ── 파일 저장 위치 ──
# 파일 저장 경로는 docker-compose.prod.yml이 볼륨(damoim-storage)과 함께 고정 주입하므로
# 보통 건드릴 필요 없다 — 볼륨이 있어야 컨테이너 재생성 후에도 업로드한 사진이 살아남는다.
# 옮기려면 compose의 volumes와 STORAGE_LOCAL_DIR를 반드시 같이 바꿀 것.
# STORAGE_LOCAL_DIR=/var/lib/damoim/storage
#
# ── 파일 업로드를 S3로 옮길 때만 (선택) ──
# 미설정이면 서버 로컬 디스크(위 볼륨)에 저장한다. S3 연결 시:
# STORAGE_PROVIDER=s3
# S3_BUCKET=damoim-files
# S3_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── 인앱결제 증빙 검증 (운영 필수) ──
# 운영은 기본 ON(fail-closed)이다. 검증을 끄면(BILLING_VERIFY=false) 결제 없이 subscribe만 호출해도
# 유료 플랜이 켜지므로, 서버가 아예 구독 요청을 거부한다(끄는 의미가 없다 — 로컬 개발에서만 끌 것).
# iOS 구독을 실제로 받으려면 아래 두 줄이 필요하다:
#   1) 앱 번들 ID (Xcode의 Bundle Identifier와 정확히 동일해야 한다)
# APPLE_BUNDLE_ID=com.damoim.app
#   2) Apple 루트 CA 인증서 — https://www.apple.com/certificateauthority/ 에서 AppleRootCA-G3.cer 다운로드 후
#      집 PC의  damoim-server/secrets/AppleRootCA-G3.cer  에 두면 compose가 컨테이너에 마운트한다(경로 기본값 사용).
#      (파일이 없거나 APPLE_BUNDLE_ID가 비면 App Store 증빙 검증 불가 → 구독 요청이 거부된다)
# APPLE_ROOT_CERT_PATH=/etc/damoim/secrets/AppleRootCA-G3.cer
#
# Android(Play) 결제는 아직 서버 검증 미구성 — PLAY 요청은 항상 거부된다(PLAY_NOT_CONFIGURED).
# 붙이는 방법은 billing/PlayReceiptVerifier.kt 주석 참고(서비스계정 키 + 의존성 추가 필요).
# PLAY_PACKAGE_NAME=
# PLAY_SERVICE_ACCOUNT=/etc/damoim/secrets/play-service-account.json

# ── FCM 푸시 발송 (선택) ──
# 미설정이면 서버는 정상 기동하고 폰 푸시만 안 나간다(인앱 알림은 정상).
# 켜려면: Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성"으로 받은 JSON을
#   집 PC의  damoim-server/secrets/firebase-service-account.json  에 두고(자동 gitignore),
#   아래 한 줄만 켜면 된다(경로는 compose가 컨테이너에 마운트하므로 그대로 둘 것):
# FIREBASE_ENABLED=true
# FIREBASE_PROJECT_ID=damoim-3b22c
